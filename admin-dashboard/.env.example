# Copy to .env. Never commit the real file (it's gitignored).

# Random secret used to sign the session cookie. Left blank on purpose —
# the server generates and saves one here automatically on first boot.
SESSION_SECRET=

# Port this admin app listens on (127.0.0.1 only — never exposed to the network).
ADMIN_DASHBOARD_PORT=4400

# There is no admin username/password here on purpose: the first time you
# open the app, its login page offers "Create account" to set one up. If you
# ever forget it, reset it from a terminal instead:
#   node admin-dashboard/scripts/set-admin-password.js <username> <password>
