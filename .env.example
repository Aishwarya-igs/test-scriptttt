# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed — it holds real credentials and API keys.

# Environment selection: dev, qa, prod
TEST_ENV=prod

# Dev environment URL
DEV_OTT_BASE_URL=https://dev.iwanttfc.com/

# QA environment URL
QA_OTT_BASE_URL=https://qa.iwanttfc.com/

# Prod environment URL
PROD_OTT_BASE_URL=https://iwanttfc.com/

# Login credentials (used by auth scenarios)
INVALID_LOGIN_EMAIL=
INVALID_LOGIN_PASSWORD=
VALID_LOGIN_EMAIL=
VALID_LOGIN_PASSWORD=
PROVIDER_EMAIL=
PROVIDER_PASSWORD=
MOBILE_LOGIN_COUNTRYCODE=
MOBILE_LOGIN_MOBILENUMBER=
MOBILE_LOGIN_PASSWORD=
FREE_USER_EMAIL=
FREE_USER_PASSWORD=
UNWATCHED_LOGIN_EMAIL=
UNWATCHED_LOGIN_PASSWORD=
FREE_USER_LOGIN_EMAIL=
FREE_USER_LOGIN_PASSWORD=

# Dashboard: RCA (root cause analysis) for failed tests.
# RCA_PROVIDER=heuristic (default) - free, instant, zero network, rule-based only.
# RCA_PROVIDER=ollama - local model via Ollama on THIS machine only; not a fit
#   for a shared team deploy, but zero data leaves the machine. Falls back to
#   heuristics if Ollama isn't reachable.
# RCA_PROVIDER=api - single API key/endpoint configured here, used by the whole
#   team once this dashboard is deployed. Set RCA_API_FORMAT to match your
#   provider's wire format, and RCA_API_KEY to that provider's key. Falls back
#   to heuristics if the call fails for any reason (bad key, network, etc.).
#   RCA_API_FORMAT=openai (default) - OpenAI, Groq, OpenRouter, Together,
#     Mistral, Azure-OpenAI-style proxies, self-hosted OpenAI-compatible
#     servers (LM Studio, vLLM). Uses RCA_API_BASE_URL (default
#     https://api.openai.com/v1) and RCA_API_MODEL (default gpt-4o-mini).
#     Example for Groq: RCA_API_BASE_URL=https://api.groq.com/openai/v1,
#     RCA_API_MODEL=llama-3.3-70b-versatile.
#   RCA_API_FORMAT=anthropic - a direct Claude API key. Uses RCA_API_BASE_URL
#     (default https://api.anthropic.com/v1) and RCA_API_MODEL (default
#     claude-3-5-haiku-20241022).
# Dashboard: stalled-run detection. A run whose browser dies can leave
# Playwright blocked forever — every process stays alive and the status stays
# "running" while nothing progresses. The dashboard flags a run that has
# reported no test events for this long (default 10 min; must stay above the
# longest single test, which this suite sets to 180s).
# DASHBOARD_STALL_TIMEOUT_MS=600000
# Set to "stop" to have stalled runs killed automatically instead of just
# flagged in the UI. Default is to flag only.
# DASHBOARD_STALL_ACTION=stop

#
# Spot fix (AI-proposed source edit for a failed test) uses this same
# provider config — there is nothing extra to set. It requires an actual model,
# so it is unavailable when RCA_PROVIDER=heuristic. It is offered only when the
# analysis classifies the failure as a code issue, never writes to disk without
# an explicit click, and can only ever edit files under tests/ and src/.
RCA_PROVIDER=heuristic
RCA_OLLAMA_URL=http://127.0.0.1:11434
RCA_OLLAMA_MODEL=llama3.2
RCA_API_FORMAT=openai
RCA_API_KEY=
RCA_API_BASE_URL=
RCA_API_MODEL=
